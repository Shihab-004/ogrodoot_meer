<?xml version="1.0" ?>
<!--
  NAGC 2026 Autonomous Navigation Arena
  =======================================
  - Course Size: 53 m × 34 m
  - Base Station: 2 m × 2 m Zone at (0, 0)
  - GPS Point 1: Tree Vitality Target at (16.0, 4.0)
  - GPS Point 2: 360° Panorama Station at (30.0, -6.0)
  - Terrain Obstacles: Rocks and barriers between waypoints
-->
<sdf version="1.8">
  <world name="nagc_arena">

    <!-- ── Physics Configuration ──────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── System Plugins (Gazebo Harmonic) ───────────────────────────── -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- ── Sunlight & Atmosphere ──────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- ── Ground Plane ───────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.55 0.40 1</ambient>
            <diffuse>0.65 0.55 0.40 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Base Station (2m × 2m Marked Zone at origin) ───────────────── -->
    <model name="base_station">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="base_pad">
        <visual name="pad_visual">
          <geometry>
            <box><size>2.0 2.0 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Arena Boundary Corner Markers (53m × 34m) ─────────────────── -->
    <model name="boundary_marker_1">
      <static>true</static>
      <pose>-3 -17 0.5 0 0 0</pose>
      <link name="post"><visual name="v"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><ambient>1 0.3 0 1</ambient><diffuse>1 0.3 0 1</diffuse></material></visual></link>
    </model>
    <model name="boundary_marker_2">
      <static>true</static>
      <pose>50 -17 0.5 0 0 0</pose>
      <link name="post"><visual name="v"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><ambient>1 0.3 0 1</ambient><diffuse>1 0.3 0 1</diffuse></material></visual></link>
    </model>
    <model name="boundary_marker_3">
      <static>true</static>
      <pose>50 17 0.5 0 0 0</pose>
      <link name="post"><visual name="v"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><ambient>1 0.3 0 1</ambient><diffuse>1 0.3 0 1</diffuse></material></visual></link>
    </model>
    <model name="boundary_marker_4">
      <static>true</static>
      <pose>-3 17 0.5 0 0 0</pose>
      <link name="post"><visual name="v"><geometry><cylinder><radius>0.1</radius><length>1.0</length></cylinder></geometry><material><ambient>1 0.3 0 1</ambient><diffuse>1 0.3 0 1</diffuse></material></visual></link>
    </model>

    <!-- ── GPS POINT 1: Designated Tree (Alive / Green Foliage) ──────── -->
    <!-- Located at X=16.0, Y=4.0 -->
    <model name="target_tree_point1">
      <static>true</static>
      <pose>16.0 4.0 0 0 0 0</pose>

      <!-- Waypoint Ground Ring (1.5m radius zone) -->
      <link name="waypoint_ring">
        <pose>0 0 0.003 0 0 0</pose>
        <visual name="ring_visual">
          <geometry>
            <cylinder><radius>1.5</radius><length>0.002</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.7 0.9 0.4</ambient>
            <diffuse>0.2 0.7 0.9 0.4</diffuse>
          </material>
        </visual>
      </link>

      <!-- Tree Trunk -->
      <link name="trunk">
        <pose>0 0 1.25 0 0 0</pose>
        <collision name="trunk_col">
          <geometry><cylinder><radius>0.22</radius><length>2.5</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.22</radius><length>2.5</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.25 0.15 1</ambient>
            <diffuse>0.4 0.25 0.15 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Tree Canopy / Foliage (Vibrant Alive Green) -->
      <link name="canopy">
        <pose>0 0 2.8 0 0 0</pose>
        <collision name="canopy_col">
          <geometry><sphere><radius>1.3</radius></sphere></geometry>
        </collision>
        <visual name="canopy_vis">
          <geometry><sphere><radius>1.3</radius></sphere></geometry>
          <material>
            <ambient>0.08 0.65 0.12 1</ambient>
            <diffuse>0.08 0.65 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── GPS POINT 2: 360° Panorama Station ────────────────────────── -->
    <!-- Located at X=30.0, Y=-6.0 -->
    <model name="panorama_station_point2">
      <static>true</static>
      <pose>30.0 -6.0 0 0 0 0</pose>
      <!-- Waypoint Ground Ring (1.5m radius zone) -->
      <link name="pad">
        <pose>0 0 0.003 0 0 0</pose>
        <visual name="pad_vis">
          <geometry><cylinder><radius>1.5</radius><length>0.002</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.2 0.9 0.4</ambient>
            <diffuse>0.8 0.2 0.9 0.4</diffuse>
          </material>
        </visual>
      </link>
      <!-- Small landmark flag/marker -->
      <link name="pole">
        <pose>0 0 1.0 0 0 0</pose>
        <collision name="pole_col">
          <geometry><cylinder><radius>0.05</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="pole_vis">
          <geometry><cylinder><radius>0.05</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── OBSTACLES: Rocks / Boulders Between Waypoints ──────────────── -->

    <!-- Obstacle 1: Boulder on path to Point 1 -->
    <model name="boulder_1">
      <static>true</static>
      <pose>6.5 1.2 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.6</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Large rock block near Point 1 -->
    <model name="rock_block_2">
      <static>true</static>
      <pose>11.0 -0.8 0.45 0 0 0.5</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.3 0.9 0.9</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.3 0.9 0.9</size></box></geometry>
          <material><ambient>0.4 0.38 0.35 1</ambient><diffuse>0.4 0.38 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: Pillar rock off to the side -->
    <model name="rock_pillar_3">
      <static>true</static>
      <pose>13.5 5.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: Large rock barrier between Point 1 and Point 2 -->
    <model name="boulder_4">
      <static>true</static>
      <pose>23.0 -1.0 0.5 0 0 0.2</pose>
      <link name="link">
        <collision name="c">
          <geometry><cylinder><radius>0.85</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.85</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.38 0.35 0.32 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 5: Rock ridge obstacle near Point 2 -->
    <model name="rock_barrier_5">
      <static>true</static>
      <pose>26.0 3.0 0.45 0 0 -0.4</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>1.6 0.8 0.9</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>1.6 0.8 0.9</size></box></geometry>
          <material><ambient>0.32 0.32 0.32 1</ambient><diffuse>0.32 0.32 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
