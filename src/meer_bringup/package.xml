<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meer_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level bringup package for the MEER rover (NAGC 2026).
    Contains simulation and hardware launch files, controller configs,
    and orchestration of all rover subsystems.
  </description>
  <maintainer email="team@nagc2026.local">NAGC 2026 Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>meer_description</exec_depend>
  <exec_depend>meer_hardware</exec_depend>
  <exec_depend>meer_perception</exec_depend>
  <exec_depend>meer_navigation</exec_depend>
  <exec_depend>meer_mission_control</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
