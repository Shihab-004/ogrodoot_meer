<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meer_hardware</name>
  <version>0.1.0</version>
  <description>
    Hardware interface package for the MEER rover.
    Implements a ros2_control SystemInterface that communicates
    over UART / micro-ROS to an ESP32 controlling 4x 24V DC motors
    via Cytron MDDS30 drivers (Sign-Magnitude PWM+DIR protocol).
  </description>
  <maintainer email="team@nagc2026.local">NAGC 2026 Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/meer_hardware_plugin.xml"/>
  </export>
</package>
