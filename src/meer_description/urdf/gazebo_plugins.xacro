<?xml version="1.0"?>
<!--
  Gazebo Harmonic Plugin Xacro for MEER Rover
  =============================================
  Native Gazebo Harmonic plugins:
    - DiffDrive: Direct 4WD skid-steer physics drive on /cmd_vel
    - JointStatePublisher: publishes wheel joint states
    - 2D LiDAR: /lidar/scan
    - IMU: /imu/data
    - GPS: /gps/fix
    - RGB Camera: /camera/image_raw
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ─── Native Gazebo Differential Drive (Skid-Steer 4WD) ──────────── -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <!-- 4 Driven Wheels -->
      <left_joint>front_left_wheel</left_joint>
      <left_joint>back_left_wheel</left_joint>
      <right_joint>front_right_wheel</right_joint>
      <right_joint>back_right_wheel</right_joint>

      <!-- Kinematics from Real CAD Model -->
      <wheel_separation>0.8184</wheel_separation>
      <wheel_radius>0.1155</wheel_radius>

      <!-- Topics -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <!-- Velocity & Acceleration Limits -->
      <max_linear_acceleration>5.0</max_linear_acceleration>
      <min_linear_acceleration>-5.0</min_linear_acceleration>
      <max_angular_acceleration>8.0</max_angular_acceleration>
      <min_angular_acceleration>-8.0</min_angular_acceleration>
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <min_angular_velocity>-3.0</min_angular_velocity>

      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <!-- ─── Native Gazebo Joint State Publisher ─────────────────────────── -->
  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>front_left_wheel</joint_name>
      <joint_name>back_left_wheel</joint_name>
      <joint_name>front_right_wheel</joint_name>
      <joint_name>back_right_wheel</joint_name>
    </plugin>
  </gazebo>

  <!-- ─── Wheel friction / contact settings ──────────────────────────── -->
  <!-- Tuned for skid-steer: high forward grip (mu1), low lateral grip (mu2) for turning -->
  <xacro:macro name="wheel_gazebo_friction" params="link_name">
    <gazebo reference="${link_name}">
      <mu1>1.2</mu1>
      <mu2>0.4</mu2>
      <kp>1e6</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <fdir1>1 0 0</fdir1>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_gazebo_friction link_name="FLW"/>
  <xacro:wheel_gazebo_friction link_name="BLW"/>
  <xacro:wheel_gazebo_friction link_name="FRW"/>
  <xacro:wheel_gazebo_friction link_name="BRW"/>

  <!-- ─── Base link visual / collision material ──────────────────────── -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="enclsr">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="Left_rocker">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="right_rocker">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- =================================================================
       SENSOR PLUGINS (Gazebo Harmonic / gz-sim 8)
  ================================================================== -->

  <!-- ─── 2D LiDAR ─────────────────────────────────────────────────── -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/lidar/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ─── IMU ──────────────────────────────────────────────────────── -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev><bias_mean>0</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ─── GPS / NavSat ─────────────────────────────────────────────── -->
  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <pose>0 0 0 0 0 0</pose>
      <topic>/gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <update_rate>1</update_rate>
      <always_on>1</always_on>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise>
          </horizontal>
          <vertical>
            <noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise>
          </vertical>
        </position_sensing>
        <velocity_sensing>
          <horizontal>
            <noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise>
          </horizontal>
          <vertical>
            <noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise>
          </vertical>
        </velocity_sensing>
      </navsat>
    </sensor>
  </gazebo>

  <!-- ─── RGB Camera ──────────────────────────────────────────────── -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <optical_frame_id>camera_optical_link</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

</robot>
