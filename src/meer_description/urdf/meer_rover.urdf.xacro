<?xml version="1.0"?>
<!--
  MEER Rover — Main Xacro Entry Point
  NAGC 2026 Autonomous Navigation Mission

  Fully aligned with ROS REP-103 standards:
    - Forward  : +X
    - Left     : +Y
    - Up       : +Z
    - Wheel axle rotation axis: +Y [0 1 0]
-->
<robot name="meer_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =====================================================================
       Include sub-xacro files
  ====================================================================== -->
  <xacro:include filename="$(find meer_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find meer_description)/urdf/inertia_macros.xacro"/>
  <xacro:include filename="$(find meer_description)/urdf/gazebo_plugins.xacro"/>
  <xacro:include filename="$(find meer_description)/urdf/ros2_control.xacro"/>

  <!-- =====================================================================
       BASE FOOTPRINT (Ground projection, Z=0)
  ====================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.22" rpy="0 0 0"/>
  </joint>

  <!-- =====================================================================
       BASE LINK (Chassis body)
       Length (X): 0.65 m
       Width  (Y): 0.45 m
       Height (Z): 0.12 m
       Mass: 2.778 kg
  ====================================================================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.65 0.45 0.12"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.65 0.45 0.12"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.778"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_box_inertia m="2.778" x="0.65" y="0.45" z="0.12"/>
    </inertial>
  </link>

  <!-- =====================================================================
       LEFT SUSPENSION CHAIN (Rocker + Wheels on +Y)
  ====================================================================== -->

  <!-- Left Bearing (fixed mount on left side of chassis at Y = +0.225) -->
  <link name="left_bearing">
    <visual>
      <geometry><cylinder radius="0.02" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.02" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="0.103"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_cylinder_inertia m="0.103" r="0.02" h="0.04"/>
    </inertial>
  </link>

  <joint name="LBRING" type="fixed">
    <parent link="base_link"/>
    <child link="left_bearing"/>
    <origin xyz="0.0 0.225 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- Left Rocker (revolute joint around pitch Y axis) -->
  <link name="Left_rocker">
    <visual>
      <geometry><box size="0.60 0.05 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="0.60 0.05 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="4.921"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_box_inertia m="4.921" x="0.60" y="0.05" z="0.04"/>
    </inertial>
  </link>

  <joint name="leftrocker" type="revolute">
    <parent link="left_bearing"/>
    <child link="Left_rocker"/>
    <origin xyz="0 0.03 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.26" upper="0.26" effort="100" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- FLW — Front Left Wheel (continuous driven wheel, rolling around Y axis) -->
  <link name="FLW">
    <visual>
      <geometry><cylinder radius="0.10" length="0.07"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.07"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="1.911"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_cylinder_inertia m="1.911" r="0.10" h="0.07"/>
    </inertial>
  </link>

  <joint name="front_left_wheel" type="continuous">
    <parent link="Left_rocker"/>
    <child link="FLW"/>
    <origin xyz="0.25 0.05 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- BLW — Back Left Wheel (continuous driven wheel, rolling around Y axis) -->
  <link name="BLW">
    <visual>
      <geometry><cylinder radius="0.10" length="0.07"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.07"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="1.911"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_cylinder_inertia m="1.911" r="0.10" h="0.07"/>
    </inertial>
  </link>

  <joint name="back_left_wheel" type="continuous">
    <parent link="Left_rocker"/>
    <child link="BLW"/>
    <origin xyz="-0.25 0.05 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- =====================================================================
       RIGHT SUSPENSION CHAIN (Rocker + Wheels on -Y)
  ====================================================================== -->

  <!-- Right Bearing (fixed mount on right side of chassis at Y = -0.225) -->
  <link name="right_bearing">
    <visual>
      <geometry><cylinder radius="0.02" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.02" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="0.103"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_cylinder_inertia m="0.103" r="0.02" h="0.04"/>
    </inertial>
  </link>

  <joint name="RBRING" type="fixed">
    <parent link="base_link"/>
    <child link="right_bearing"/>
    <origin xyz="0.0 -0.225 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- Right Rocker (revolute joint around pitch Y axis) -->
  <link name="right_rocker">
    <visual>
      <geometry><box size="0.60 0.05 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="0.60 0.05 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="4.921"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_box_inertia m="4.921" x="0.60" y="0.05" z="0.04"/>
    </inertial>
  </link>

  <joint name="rightrcker" type="revolute">
    <parent link="right_bearing"/>
    <child link="right_rocker"/>
    <origin xyz="0 -0.03 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.26" upper="0.26" effort="100" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- FRW — Front Right Wheel (continuous driven wheel, rolling around Y axis) -->
  <link name="FRW">
    <visual>
      <geometry><cylinder radius="0.10" length="0.07"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.07"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="1.911"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_cylinder_inertia m="1.911" r="0.10" h="0.07"/>
    </inertial>
  </link>

  <joint name="front_right_wheel" type="continuous">
    <parent link="right_rocker"/>
    <child link="FRW"/>
    <origin xyz="0.25 -0.05 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- BRW — Back Right Wheel (continuous driven wheel, rolling around Y axis) -->
  <link name="BRW">
    <visual>
      <geometry><cylinder radius="0.10" length="0.07"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.10" length="0.07"/></geometry>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
    </collision>
    <inertial>
      <mass value="1.911"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_cylinder_inertia m="1.911" r="0.10" h="0.07"/>
    </inertial>
  </link>

  <joint name="back_right_wheel" type="continuous">
    <parent link="right_rocker"/>
    <child link="BRW"/>
    <origin xyz="-0.25 -0.05 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="20"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- =====================================================================
       SENSOR LINKS (Standard ROS frames)
       LiDAR  → top center of base_link (+X forward)
       Camera → front face of base_link (+X forward)
       IMU    → geometric center of base_link
       GPS    → rear top of base_link (-X)
  ====================================================================== -->

  <!-- ── 2D LiDAR ──────────────────────────────────────────────────────── -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:solid_cylinder_inertia m="0.1" r="0.04" h="0.04"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0.0 0.18" rpy="0 0 0"/>
  </joint>

  <!-- ── IMU ───────────────────────────────────────────────────────────── -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ── GPS / NavSat ──────────────────────────────────────────────────── -->
  <link name="gps_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.20 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- ── RGB Camera ─────────────────────────────────────────────────────── -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.325 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Camera optical frame (ROS standard: z-forward, x-right, y-down) -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

</robot>
